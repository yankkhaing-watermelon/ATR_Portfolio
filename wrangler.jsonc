{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atr-portfolio",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "main": "./worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atr-portfolio-db",
      "database_id": "41f73187-8d16-4794-913f-dc68179b085f"
    }
  ]
}
